{
  "name": "obix-config-jest",
  "version": "0.5.0",
  "description": "OBIX Jest test configuration for OBIX CLI and SDK packages",
  "license": "MIT",
  "author": "Nnamdi Michael Okpala <okpalan@protonmail.com>",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./base": "./jest.config.js",
    "./unit": "./unit/jest.config.js",
    "./integration": "./integration/jest.config.js",
    "./performance": "./performance/jest.config.js",
    "./setup": "./jest.setup.js",
    "./reporter": "./state-machine-performance-reporter.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "jest.config.js",
    "jest.setup.js",
    "state-machine-performance-reporter.js",
    "unit",
    "integration",
    "performance",
    "test",
    "CHANGELOG.md",
    "PROVENANCE.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/*.test.mjs\""
  },
  "peerDependencies": {
    "@types/jest": ">=29.0.0",
    "jest": ">=29.0.0",
    "ts-jest": ">=29.0.0"
  },
  "peerDependenciesMeta": {
    "jest-junit": {
      "optional": true
    },
    "jest-watch-select-projects": {
      "optional": true
    },
    "jest-watch-typeahead": {
      "optional": true
    },
    "@types/jest": {
      "optional": true
    },
    "jest": {
      "optional": true
    },
    "ts-jest": {
      "optional": true
    }
  },
  "keywords": [
    "obix"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/obinexus/obix-config-jest.git"
  },
  "bugs": {
    "url": "https://github.com/obinexus/obix-config-jest/issues"
  },
  "homepage": "https://github.com/obinexus/obix-config-jest#readme"
}
